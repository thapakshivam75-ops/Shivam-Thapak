# Local development default. For Render, set these in its Environment dashboard instead.
# Hosted OpenAI-compatible option (Groq): https://api.groq.com/openai/v1
AI_API_FORMAT=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_API_KEY=
AI_MODEL=llama3.2:1b
AI_FALLBACK_MODEL=
AI_MAX_OUTPUT_TOKENS=384

# Optional. Google OAuth read-only email integration is not enabled until implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# For private/local mode only. Never commit .env or place provider keys in frontend code.
ASSISTANT_PASSWORD=
HOST=127.0.0.1
PORT=3000
# Deployment-only settings (Render supplies PORT; do not commit live credentials).
PUBLIC_CHAT_ONLY=false
TRUST_PROXY=false
